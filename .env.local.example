# Local development — point to your local Postgres
POSTGRES_URL="postgresql://user:password@localhost:5432/devfootwear"

# Session signing secret (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Email OTP (optional in dev — OTP is shown on screen if not set)
# Sign up free at https://resend.com (3,000 emails/month)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Dev Footwear <onboarding@resend.dev>"

# Production (Vercel) — set these in Vercel dashboard environment variables
# POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
